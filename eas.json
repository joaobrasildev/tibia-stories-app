{
    "cli": {
        "version": ">= 3.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "ENV_FILE": ".env.development"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "ENV_FILE": ".env.development"
            }
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "ENV_FILE": ".env.production"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "production"
            },
            "ios": {
                "appleId": "SEU_APPLE_ID"
            }
        }
    }
}