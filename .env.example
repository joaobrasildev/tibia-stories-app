# ============================================
# Tibia Stories App — Variáveis de Ambiente
# ============================================
# Copie para .env e preencha os valores reais.
# Este arquivo (.env.example) é commitado no git como referência.

# -----------------------------------------------
# Firebase JS SDK Config
# Firebase Console → Project Settings → General → Web app → Config
# -----------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------
# Google Sign-In (OAuth 2.0)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# -----------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# -----------------------------------------------
# AdMob (Fase 13)
# Google AdMob Console → Apps → App settings / Ad units
# -----------------------------------------------
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID_ID=
# EXPO_PUBLIC_ADMOB_BANNER_IOS_ID=
