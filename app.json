{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-9302632754670115~1587513719",
    "ios_app_id": "ca-app-pub-9302632754670115~9789437362",
    "delay_app_measurement_init": true
  },
  "expo": {
    "name": "Tibia Stories",
    "slug": "tibia-stories",
    "version": "1.0.0",
    "scheme": "tibiastories",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#8B2020"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9302632754670115~1587513719",
          "iosAppId": "ca-app-pub-9302632754670115~9789437362",
          "delay_app_measurement_init": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Este app utiliza identificadores para exibir anúncios relevantes. Seus dados não são compartilhados com terceiros."
        }
      ]
    ],
    "android": {
      "package": "com.tibiastories.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#8B2020"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.tibiastories.app",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1b2e9243-381b-4cf8-9f8d-f800214c9016"
      }
    }
  }
